<!DOCTYPE html>
<html lang="ko" xmlns:th="http://www.thymeleaf.org"
xmlns:layout="http://www.ultraq.net.nz/thymeleaf/layout"
layout:decorate="layout/default_layout"
layout:fragment="content">
        
        <section class="page-section cta">
		    <div class="container-fluid"> <!-- 변경: container-fluid로 패딩 제거 -->
		        <div class="row">
		            <div class="col-xl-9 mx-auto">
		                <div class="cta-inner bg-faded text-center rounded">
		                
		                    <h2 class="map-heading mb-4">
		                        <span class="map-heading-upper">특산물 찾기</span>
		                    </h2>
		                    
		                    <!-- 박스 사이즈를 화면 가로 끝까지 확장 -->
		                    <div class="plant-box mt-3">
		                        <div class="map-content" id="map" style="display: flex; flex-direction: column; height: 100%; overflow: hidden;">
		                        </div>
		                    </div>
		                    
		                </div>
		            </div>
		        </div>
		    </div>
		</section>
        
		<script type="text/javascript" src="//dapi.kakao.com/v2/maps/sdk.js?appkey=fb1f322e9276b2caa266aba56aa8e976"></script>
		<script>
			var container = document.getElementById('map');
			var options = {
				center: new kakao.maps.LatLng(33.450701, 126.570667),
				level: 3
			};
		
			var map = new kakao.maps.Map(container, options);
		</script>

</html>
