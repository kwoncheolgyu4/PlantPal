<!DOCTYPE html>
<html lang="ko" xmlns:th="http://www.thymeleaf.org"
xmlns:layout="http://www.ultraq.net.nz/thymeleaf/layout"
layout:decorate="layout/default_layout"
layout:fragment="content">
        
       	<section class="page-section cta">
            <div class="container">
                <div class="row">
                    <div class="col-xl-8 mx-auto">
                        <div class="cta-inner bg-faded text-center rounded">
                            <div class="row justify-content-center">
				                <div class="col-md-8 col-lg-8">
				                    <h1 class="text-center mb-4">MyPage</h1>
				                    <form th:action="@{/logoutDo}" method="post">
				                        <div class="mb-3">
				                            <label for="memId" class="form-label"></label>
				                            <input type="text" id="memId" name="memId" th:value="${session.login.memId}" class="form-control" required disabled>
				                        </div>
				                        <div class="mb-3">
				                            <label for="memNm" class="form-label"></label>
				                            <input type="text" id="memNm" name="memNm" th:value="${session.login.memNm}" class="form-control" required>
				                        </div>
				                        <div class="d-grid">
				                            <button type="submit" class="btn btn-primary">Logout</button>
				                            <a href="/" type="button" class="btn btn-primary mt-3">Home</a>
				                        </div>
				                    </form>
				                </div>
				            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

</html>
