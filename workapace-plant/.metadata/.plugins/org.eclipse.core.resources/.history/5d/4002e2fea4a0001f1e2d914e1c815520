<!DOCTYPE html>
<html lang="ko" xmlns:th="http://www.thymeleaf.org"
xmlns:layout="http://www.ultraq.net.nz/thymeleaf/layout"
layout:decorate="layout/default_layout"
layout:fragment="content">
        
       	<section class="page-section cta">
            <div class="container">
                <div class="row">
                    <div class="col-xl-8 mx-auto">
                        <div class="cta-inner bg-faded text-center rounded">
                            <div class="row justify-content-center">
				                <div class="col-md-8 col-lg-8">
				                    <h1 class="text-center mb-4">SIGN UP</h1>
				                    
				                    <form th:action="@{/signUpDo}" method="post" th:object="${member}">
				                        <div class="mb-3">
				                            <label for="memId" class="form-label">아이디</label>
				                            <input type="text" id="memId" name="memId" class="form-control" required th:field="*{memId}">
				                            <p class="text-danger" th:if="${#fields.hasErrors('memId')}" th:errors="*{memId}">아이디 오류</p>
				                        </div>
				                        <div class="mb-3">
				                            <label for="memPw" class="form-label">비밀번호</label>
				                            <input type="password" id="memPw" name="memPw" class="form-control" required th:field="*{memPw}">
				                            <p class="text-danger" th:if="${#fields.hasErrors('memPw')}" th:errors="*{memPw}">비밀번호 오류</p>
				                        </div>
				                        <div class="mb-3">
				                            <label for="memNm" class="form-label">이름</label>
				                            <input type="text" id="memNm" name="memNm" class="form-control" required th:field="*{memNm}">
				                            <p class="text-danger" th:if="${#fields.hasErrors('memNm')}" th:errors="*{memNm}">이름 오류</p>
				                        </div>
				                        <div class="d-grid">
				                            <button type="submit" class="btn btn-primary">SignUp</button>
				                            <a href="/" type="button" class="btn btn-primary mt-3">Home</a>
				                        </div>
				                    </form>
				                </div>
				            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
		
		<!-- message Modal -->
		<div class="modal fade" id="messageModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
		  <div class="modal-dialog">
		    <div class="modal-content">
		      <div class="modal-header">
		        <h1 class="modal-title fs-5" id="exampleModalLabel">${messageVO.title}</h1>
		        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
		      </div>
			      <div class="modal-body">
	                     <!-- message -->
	                     <div class="mb-3">
	                         <label for="title">${messageVO.message}</label>
	                     </div>
	                     <a href="<c:url value='${messageVO.url}' />" >
	                     	${messageVO.urlTitle}
	                     </a>
			      </div>
			      <div class="modal-footer">
			        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">닫기</button>
			      </div>
		    </div>
		  </div>
		</div>
		
		<script>
			$(document).ready(function(){
				var message = "${messageVO.message}";
				if(message != ''){
					$("#messageModal").modal('show');
				}
			})
		</script>
</html>
