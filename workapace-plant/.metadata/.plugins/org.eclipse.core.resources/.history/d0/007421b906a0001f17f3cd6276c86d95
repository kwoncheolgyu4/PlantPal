<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.future.plant.member.dao.IMemberDAO">

	<insert id="signUpMember" parameterType="MemberVO">
	
    	INSERT INTO members(mem_id, mem_pw, mem_nm)
		VALUES(#{userId}, #{userPw}, #{userNm})
			
	</insert>
	
	<select id="loginMember" parameterType="MemberVO" resultType="MemberVO">
	
		SELECT mem_id
		     , mem_nm
		FROM members
		WHERE use_yn = 'Y'
		AND   mem_id = #{userId}
		AND   mem_pw = #{userPw}
	
	</select>
	
	
</mapper>